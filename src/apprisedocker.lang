# ===========================================================================
# Multilingual file for the TOS 7 Docker application "apprisedocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Apprise API"
auth         = "caronc"
version      = "@@VERSION@@"
descript     = "Apprise API is a single endpoint that delivers notifications to more than a hundred services - Mailgun, Telegram, ntfy, Slack, Discord, Gotify, webhooks and many more. Define the destinations once, store them under a tag, and let any script or app POST a message to that tag; the UI lets you test notifications and keep the configuration organised."
release_note = "1. First release: Apprise API 2.1.0 from Docker Hub as a non-root container. One HTTP endpoint for 100+ notification services, web UI for testing and tag-based configuration in the application data folder."
important    = "Requires DockerEngine (installed automatically if missing). Add notification URLs in the web UI (each service has a documented URL format), save them under a tag, then POST to /notify/<tag> from your scripts. Destinations are stored in DockerAppData/apprisedocker/config/config.yml. There is no built-in authentication by default - keep the port on your LAN or protect it with a reverse proxy. Plain HTTP; use TLS for remote access."

[zh-cn]
name         = "Apprise API"
auth         = "caronc"
version      = "@@VERSION@@"
descript     = "Apprise API 是一个统一的推送入口，能把通知发到上百种服务——Mailgun、Telegram、ntfy、Slack、Discord、Gotify、webhook 等等。把目标地址配置一次、存到一个 tag 下，任何脚本或应用只要向这个 tag POST 一条消息即可；界面里可以直接测试并管理配置。"
release_note = "1. 首个版本：基于 Docker Hub 的 Apprise API 2.1.0，以非 root 容器运行。一个 HTTP 入口对接 100+ 通知服务，界面可测试，配置按 tag 保存在应用数据目录。"
important    = "需要 DockerEngine（缺失时应用中心会自动安装）。在网页里添加各服务的通知 URL（每种服务都有固定的 URL 格式），存到一个 tag 下，然后让脚本 POST 到 /notify/<tag>。目标配置保存在 DockerAppData/apprisedocker/config/config.yml。默认没有登录鉴权——请只在内网使用，或用反向代理加一层保护。界面为纯 HTTP，远程访问请配 TLS。"

[zh-hk]
name         = "Apprise API"
auth         = "caronc"
version      = "@@VERSION@@"
descript     = "Apprise API 是一個統一的推送入口，能把通知發到上百種服務——Mailgun、Telegram、ntfy、Slack、Discord、Gotify、webhook 等等。把目標位址設定一次、存到一個 tag 下，任何腳本或應用只要向這個 tag POST 一條訊息即可；介面裡可以直接測試並管理設定。"
release_note = "1. 首個版本：基於 Docker Hub 的 Apprise API 2.1.0，以非 root 容器運行。一個 HTTP 入口對接 100+ 通知服務，介面可測試，設定按 tag 保存在應用資料目錄。"
important    = "需要 DockerEngine（缺少時應用中心會自動安裝）。在網頁裡新增各服務的通知 URL（每種服務都有固定的 URL 格式），存到一個 tag 下，然後讓腳本 POST 到 /notify/<tag>。目標設定保存在 DockerAppData/apprisedocker/config/config.yml。預設沒有登入鑑權——請只在內網使用，或用反向代理加一層保護。介面為純 HTTP，遠端存取請配 TLS。"

