# ===========================================================================
# Multilingual file for the TOS 7 Docker application "apprisedocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (publisher/maintainer), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Apprise API"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Apprise API (LinuxServer.io rebuild of caronc/apprise-api) is one HTTP endpoint that forwards a message to the notification services you configure - Telegram, Discord, Slack, SMTP, webhooks, ntfy, Gotify and 100+ more. The message and the credentials you save are sent only to those endpoints, in the region the provider operates. A web UI manages and tests the destinations; configurations live under /config."
release_note = "2.1.0-2: review remediation - public privacy policy (PRIVACY.md) with third-party endpoint disclosure, corrected auth and configuration-path metadata, HTTP Basic Auth enabled by default (generated admin password in config/admin-credentials.txt)."
important    = "Requires DockerEngine (auto-installed). Web login user 'admin'; the random password is in DockerAppData/apprisedocker/config/admin-credentials.txt (delete it and restart to rotate). Add notification URLs in the UI, save them under a tag, then POST /notify/<tag>. Destinations and tokens stay under /config; no telemetry. Plain HTTP for LAN use - TLS reverse proxy for remote access. See PRIVACY.md."

[zh-cn]
name         = "Apprise API"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Apprise API（caronc/apprise-api 的 LinuxServer.io 重打包）是一个统一的 HTTP 入口：把消息转发到你配置的通知服务——Telegram、Discord、Slack、SMTP、webhook、ntfy、Gotify 等 100 多种。消息内容和保存的凭据只会发给你选定的服务端点，目的地由该服务商所在区域决定。网页界面可管理和测试目标，配置保存在 /config 下。"
release_note = "2.1.0-2：按审核意见整改——新增公开隐私政策 PRIVACY.md（含第三方端点披露），修正 auth 与配置存储路径描述，默认启用 HTTP 基本认证（随机管理员密码见 config/admin-credentials.txt）。"
important    = "需要 DockerEngine（缺失时自动安装）。网页登录用户为 admin，随机密码保存在 DockerAppData/apprisedocker/config/admin-credentials.txt（删除该文件并重启即可重置）。在网页里添加通知 URL 并存到 tag 下，然后 POST /notify/<tag>。目标与令牌只保存在 /config，无遥测。界面为局域网明文 HTTP，远程访问请用带 TLS 的反向代理。隐私政策见 PRIVACY.md。"

[zh-hk]
name         = "Apprise API"
auth         = "Moechz"
version      = "@@VERSION@@"
descript     = "Apprise API（caronc/apprise-api 的 LinuxServer.io 重打包）是一個統一的 HTTP 入口：把訊息轉發到你設定的通知服務——Telegram、Discord、Slack、SMTP、webhook、ntfy、Gotify 等 100 多種。訊息內容和儲存的憑據只會發給你選定的服務端點，目的地由該服務商所在區域決定。網頁介面可管理和測試目標，設定保存在 /config 下。"
release_note = "2.1.0-2：按審核意見整改——新增公開隱私政策 PRIVACY.md（含第三方端點披露），修正 auth 與設定儲存路徑描述，預設啟用 HTTP 基本認證（隨機管理員密碼見 config/admin-credentials.txt）。"
important    = "需要 DockerEngine（缺少時自動安裝）。網頁登入用戶為 admin，隨機密碼保存在 DockerAppData/apprisedocker/config/admin-credentials.txt（刪除該檔案並重啟即可重設）。在網頁裡新增通知 URL 並存到 tag 下，然後 POST /notify/<tag>。目標與權杖只保存在 /config，無遙測。介面為區域網路明文 HTTP，遠端存取請用帶 TLS 的反向代理。隱私政策見 PRIVACY.md。"

